<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>

<?import javafx.scene.control.SeparatorMenuItem?>
<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gymsystem.GymController">

    <top>
        <MenuBar>
            <menus>
                <Menu text="Menu">
                    <items>
                        <MenuItem text="Save CSV" onAction="#handleSave"/>
                        <MenuItem text="Load CSV" onAction="#handleLoad"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Quit" onAction="#handleQuit"/>
                    </items>
                </Menu>

                <Menu text="Help">
                    <items>
                        <MenuItem text="About" onAction="#handleAbout"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <left>
        <ScrollPane fitToWidth="true" prefWidth="360.0">
            <content>
                <VBox spacing="16.0">
                    <padding>
                        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
                    </padding>

                    <VBox spacing="10.0">
                        <Label text="Add Member" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                        <GridPane hgap="10.0" vgap="10.0">
                            <Label text="Full Name* :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="fullNameField" promptText="Enter full name"
                                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Contact* :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="contactField" promptText="Enter phone or email"
                                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Address* :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextField fx:id="addressField" promptText="Enter address"
                                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Membership Type* :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="membershipTypeComboBox" prefWidth="180.0"
                                      promptText="Select membership type"
                                      GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                            <Button text="Add Member"
                                    onAction="#handleAddMember"
                                    prefWidth="180.0"
                                    GridPane.rowIndex="4"
                                    GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>

                    <Separator/>

                    <VBox spacing="10.0">
                        <Label text="Member Actions" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                        <GridPane hgap="10.0" vgap="10.0">
                            <Label text="Member ID* :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="memberIdField" promptText="Enter member ID"
                                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="New Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="newNameField" promptText="Enter updated name"
                                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="New Contact:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextField fx:id="newContactField" promptText="Enter updated contact"
                                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="New Address:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <TextField fx:id="newAddressField" promptText="Enter updated address"
                                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                            <Label text="Payment:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <TextField fx:id="paymentAmountField" promptText="Enter payment amount"
                                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        </GridPane>

                        <VBox spacing="8.0">
                            <Button text="Update Member"  onAction="#handleUpdateMember" maxWidth="1.7976931348623157E308"/>
                            <Button text="Record Check-In" onAction="#handleRecordCheckIn" maxWidth="1.7976931348623157E308"/>
                            <Button text="Record Payment" onAction="#handleRecordPayment" maxWidth="1.7976931348623157E308"/>

                            <HBox spacing="8.0">
                                <Button text="Set Active" onAction="#handleSetActive" maxWidth="1.7976931348623157E308"/>
                                <Button text="Set Inactive" onAction="#handleSetInactive" maxWidth="1.7976931348623157E308"/>
                            </HBox>

                            <Button text="View One Member" onAction="#handleViewOneMember" maxWidth="1.7976931348623157E308"/>

                        </VBox>
                    </VBox>

                    <Separator/>

                    <VBox spacing="10.0">
                        <Label text="Summary Tools" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                        <VBox spacing="8.0">
                            <Button text="View All Members"
                                    onAction="#handleViewAllMembers"
                                    maxWidth="1.7976931348623157E308"/>

                            <Button text="Total / Active Members" maxWidth="1.7976931348623157E308"/>
                            <Button text="Total Revenue" maxWidth="1.7976931348623157E308"/>
                            <Button text="Top 5 Visits" maxWidth="1.7976931348623157E308"/>
                            <Button text="Inactive / Zero Visits" maxWidth="1.7976931348623157E308"/>
                        </VBox>

                        <GridPane hgap="10.0" vgap="10.0">
                            <Label text="Type:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="summaryMembershipTypeComboBox"
                                      prefWidth="180.0"
                                      promptText="Select type"
                                      GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Button text="Avg Visits by Type"
                                    prefWidth="180.0"
                                    GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </left>

    <center>
        <VBox spacing="12.0">
            <padding>
                <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
            </padding>

            <Label text="Analytics" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <HBox spacing="12.0">
                <PieChart fx:id="membershipPieChart" title="Membership Distribution" prefHeight="250.0" prefWidth="320.0"/>

                <BarChart fx:id="revenueBarChart" title="Revenue by Membership Type" prefHeight="250.0" prefWidth="420.0">
                    <xAxis>
                        <CategoryAxis label="Membership Type"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Revenue"/>
                    </yAxis>
                </BarChart>
            </HBox>

            <Label text="Output / Results" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <TableView fx:id="memberTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="Member ID" prefWidth="90.0"/>
                    <TableColumn fx:id="nameColumn" text="Full Name" prefWidth="140.0"/>
                    <TableColumn fx:id="contactColumn" text="Contact" prefWidth="140.0"/>
                    <TableColumn fx:id="addressColumn" text="Address" prefWidth="140.0"/>
                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="100.0"/>
                    <TableColumn fx:id="visitsColumn" text="Visits" prefWidth="70.0"/>
                    <TableColumn fx:id="paidColumn" text="Total Paid" prefWidth="90.0"/>
                    <TableColumn fx:id="activeColumn" text="Active" prefWidth="70.0"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>